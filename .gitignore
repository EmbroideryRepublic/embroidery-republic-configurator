# Dependencies
/node_modules

# Next.js build output
/.next/
/out/

# Env-Dateien mit Zugangsdaten niemals committen
.env.local
.env*.local

# Betriebssystem
.DS_Store

# Vercel-Projektverknuepfung (repo.json/project.json) – lokale Deploy-Anbindung,
# wird von Vercels Tooling ohnehin ignoriert, gehoert nicht in die Versionierung.
.vercel

# Logs
npm-debug.log*

# TypeScript-Build-Cache
tsconfig.tsbuildinfo

# Lokale Entwicklungs-Logs
*.log
.next-dev.log

# Temporaere Analyse-Artefakte (Debug-Screenshots, Wegwerf-Skripte)
_tmp_*
scripts/_tmp_*
# Unterstrich-Praefix = Wegwerfskript (z.B. scripts/_pruefe.mjs). Diese lesen
# haeufig .env.local und geben Kundendaten aus - nie versionieren.
scripts/_*

# Ausgabe der visuellen Pruefstrecke (scripts/visualQa.mts u.a.) – wird bei
# jedem Durchlauf neu erzeugt, rund 43 MB, gehoert nicht in die Versionierung.
qa-screenshots/
.testablage/

# Restore-Drill (docs/restore-drill.md): Dumps und Fingerprints enthalten
# KUNDENDATEN bzw. Betriebskennzahlen – niemals committen.
restore-drill/
fingerprint-*.json
# Sicherungen vor dem Entfernen von Bestellungen (scripts/entferneTest-
# bestellungen.mjs bzw. manuelle Laeufe): enthalten Namen, Anschriften und
# E-Mail-Adressen echter Datensaetze.
sicherung-bestellungen-*.json
*.dump.sql
roles.sql
schema.sql
data.sql

# Sportyfied-Sitemap-Dump (Referenz fuer den Import, ~2MB, regenerierbar)
scripts/import/sf_sitemap.xml
