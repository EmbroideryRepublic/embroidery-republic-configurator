# Aus Supabase-Projekt → Project Settings → API kopieren.
# WICHTIG: aktuelles Key-Format verwenden (löst seit Sommer 2025 die alten
# "anon"/"service_role"-Keys ab, siehe
# https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys).
# Auf der API-Seite stehen ggf. BEIDE Formate – hier gehören die NEUEN rein:
#   Publishable key  → beginnt mit "sb_publishable_..."
#   Secret key       → beginnt mit "sb_secret_..."
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# NUR serverseitig verwenden (Admin-Bereich, Storage-Uploads, PDF-Export) –
# niemals ins Repo committen, niemals in Client Components importieren!
SUPABASE_SECRET_KEY=sb_secret_...

# Von resend.com → API Keys. Für Bestell-/Anfrage-Bestätigung, interne
# Benachrichtigung und Kontaktformular (src/lib/email/).
RESEND_API_KEY=dein-resend-api-key
#
# ACHTUNG Absender: Resend versendet AUSSCHLIESSLICH von Domains, die im
# Resend-Konto verifiziert sind. Freemail-Adressen (GMX, Gmail, …) lassen
# sich dort NICHT verifizieren – die Domain gehört dem Freemail-Anbieter.
#
# Testphase (eigene Domain noch nicht verifiziert):
#   RESEND_FROM_EMAIL=onboarding@resend.dev
#   → Resends Test-Absender. Liefert NUR an die E-Mail-Adresse, mit der das
#     Resend-Konto registriert wurde. Diese Adresse muss also identisch mit
#     EMAIL_TEST_RECIPIENT sein.
# Produktiv (nach Domain-Verifizierung):
#   RESEND_FROM_EMAIL=info@ergermany.de
RESEND_FROM_EMAIL=onboarding@resend.dev
# Wohin interne Bestell-/Anfrage-Benachrichtigungen gehen.
INTERNAL_NOTIFICATION_EMAIL=info@ergermany.de
# Antwortadresse für Mails AN Kund:innen. So landen Antworten im gelesenen
# Postfach, auch wenn als Absender noch onboarding@resend.dev steht.
EMAIL_REPLY_TO=info@ergermany.de

# Sicherheitsschalter: Solange keine verifizierte Resend-Absender-Domain
# final eingerichtet ist, werden ALLE Mails (Bestätigung + interne
# Benachrichtigung) an EMAIL_TEST_RECIPIENT umgeleitet statt an echte
# Kund:innen-Adressen. Betreff wird zusätzlich mit
# "[TEST → ursprüngliche@adresse]" markiert. Standardmäßig AN (jeder Wert
# außer exakt "false" gilt als aktiviert) – bewusst sicherer Default.
# Erst auf "false" setzen, wenn die Absender-Domain bei Resend verifiziert ist.
EMAIL_TEST_MODE=true
# Ziel-Adresse im Testmodus. Leer lassen, um INTERNAL_NOTIFICATION_EMAIL zu
# verwenden. Mit dem Test-Absender onboarding@resend.dev MUSS hier die
# Registrierungs-Adresse des Resend-Kontos stehen, sonst lehnt Resend ab.
EMAIL_TEST_RECIPIENT=info@ergermany.de

# --- Supplier Engine (Lieferanten-Automatisierung, src/lib/suppliers/) ---
# Master-Schalter Test/Prod: NUR bei '1' laeuft echte Browser-Automatisierung
# (Playwright bestellt real beim Lieferanten). Default/leer = Dry-Run: der
# gesamte Ablauf inkl. Status/Audit laeuft, aber ohne Browser/Bestellung.
SUPPLIER_AUTOMATION_ENABLED=
# Sichtbarer Browser fuer Debugging (statt headless): '1' setzen.
SUPPLIER_HEADFUL=
# Konto-Zugangsdaten je Lieferant - nur die tatsaechlich genutzten setzen.
# Welcher Lieferant welche Variablen erwartet, definiert registry.ts.
# textil-grosshandel erwartet als Benutzernamen die E-MAIL-ADRESSE des
# Geschaeftskontos (nicht einen Benutzernamen) - andernfalls antwortet der
# Shop mit "Falsche E-Mail-Adresse oder falsches Passwort!".
SUPPLIER_TG_USERNAME=
SUPPLIER_TG_PASSWORD=
SUPPLIER_WORDANS_USERNAME=
SUPPLIER_WORDANS_PASSWORD=
SUPPLIER_NEEDEN_USERNAME=
SUPPLIER_NEEDEN_PASSWORD=
SUPPLIER_RALAWISE_USERNAME=
SUPPLIER_RALAWISE_PASSWORD=

# --- Admin-Bereich (/admin) ---
# Zugangsschluessel (mind. 12 Zeichen). Ohne gesetzten Wert bleibt der
# Admin-Bereich komplett gesperrt (sicherer Default).
ADMIN_SECRET=

# --- Hintergrund-Processor (Cron) ---
# Shared Secret fuer /api/cron/process-supplier-orders. Ohne gesetzten Wert
# ist der Endpoint deaktiviert (503). Der Scheduler ruft den Endpoint mit
# `Authorization: Bearer <CRON_SECRET>` (oder ?secret=) regelmaessig auf.
CRON_SECRET=

# --- Bestellprozess: signierte Bestellansicht / Selbststornierung ---
# Schluessel fuer die Signatur des Storno-/Bestellansicht-Links in der
# Bestellbestaetigung. MINDESTENS 32 Zeichen, zufaellig erzeugt, z.B.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ohne diesen Wert wird KEIN Link erzeugt (bewusst: lieber kein Link als ein
# kaputter). Eine Aenderung entwertet alle bereits versendeten Links.
ORDER_TOKEN_SECRET=

# Basis-URL fuer Links in E-Mails (Storno-/Bestellansicht). Lokal der
# Dev-Server, produktiv die echte Domain. Fehlt der Wert, faellt der Code auf
# http://localhost:3007 zurueck – Kundenlinks waeren dann unbrauchbar.
NEXT_PUBLIC_SITE_URL=

# ── Testmodus für den End-to-End-Test ─────────────────────────────────
# NUR den exakten Wert "aktiv" setzen, und ausschließlich für Testläufe.
# Ist er gesetzt, werden E-Mails unterdrückt, Produktionsdateien in eine
# lokale Ablage geschrieben und die Lieferantenautomatisierung gesperrt.
# Der Bestellprozess selbst läuft dabei UNVERÄNDERT (Datenbank inklusive).
#
# NIEMALS im Produktivbetrieb setzen: Kundschaft bekäme keine
# Bestellbestätigung mehr, und Produktionsdateien lägen nicht im Storage.
# `npm run test:e2e` setzt die Variable selbst für seinen eigenen Server –
# hier muss sie NICHT eingetragen werden.
E2E_TESTMODUS=

# ── Stripe (Zahlungsabwicklung) ───────────────────────────────────────
# Die beiden Schlüssel entstehen zu VERSCHIEDENEN Zeitpunkten – in dieser
# Reihenfolge eintragen:
#
# 1. STRIPE_SECRET_KEY – direkt nach Anlegen des Stripe-Kontos.
#    Stripe-Dashboard → Entwickler → API-Schlüssel.
#    Testmodus: "sk_test_…"  ·  Produktivbetrieb: "sk_live_…"
#    ACHTUNG: NICHT den veröffentlichbaren Schlüssel ("pk_…") eintragen.
STRIPE_SECRET_KEY=
#
# 2. STRIPE_WEBHOOK_SECRET – entsteht ERST, wenn der Webhook-Endpunkt in
#    Stripe angelegt wurde: Entwickler → Webhooks → Endpunkt hinzufügen,
#    URL: https://<domain>/api/webhooks/stripe
#    Stripe zeigt danach den Signaturschlüssel an ("whsec_…").
#    Ohne ihn werden ALLE eingehenden Ereignisse abgewiesen – die Echtheit
#    lässt sich sonst nicht prüfen.
STRIPE_WEBHOOK_SECRET=
#
# Ein veröffentlichbarer Schlüssel (pk_…) wird NICHT benötigt: Der Checkout
# läuft als Weiterleitung zu einer von Stripe gehosteten Bezahlseite, nicht
# über ein eigenes Kartenformular. Erst wenn Karten direkt auf unserer Seite
# eingegeben werden sollen, käme er dazu.

# ───────────────────────────────────────────────────────────────────────
# DATENBANK-DIREKTVERBINDUNG (nur Werkzeuge, NICHT die Anwendung)
# ───────────────────────────────────────────────────────────────────────
#
# Die Anwendung selbst spricht ausschließlich über die Supabase-Bibliothek
# mit der Datenbank (NEXT_PUBLIC_SUPABASE_URL + Schlüssel oben). Diese beiden
# Variablen brauchen NUR die Kommandozeilen-Werkzeuge:
#
#   npm run test:e2e            Bestellstrecke gegen den echten Serverweg
#   npm run test:e2e:zahlung    Zahlungs-E2E
#   npm run test:e2e:stripe     Stripe-E2E
#   npm run test:e2e:ratelimit  Rate-Limit-E2E
#   npm run test:e2e:adminauth  Admin-Auth-E2E
#   node scripts/applyMigration.mjs        Migration anwenden
#   node scripts/restoreDrillFingerprint.mjs  Restore-Drill
#
# Zu finden im Supabase-Dashboard → Project Settings → Database →
# Connection string. DIRECT_URL ist die Direktverbindung (Port 5432),
# DATABASE_URL die über den Pooler (Port 6543). Die Werkzeuge bevorzugen
# DIRECT_URL und fallen sonst auf DATABASE_URL zurück.
#
# In der PRODUKTIONSUMGEBUNG (Vercel) werden beide NICHT benötigt.
DIRECT_URL=
DATABASE_URL=
